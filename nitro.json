{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["signalscorer"],
  "ios": {
    "iosModuleName": "NitroSignalScorer"
  },
  "android": {
    "androidNamespace": ["signalscorer"],
    "androidCxxLibName": "NitroSignalScorer"
  },
  "autolinking": {
    "SignalTicker": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridSignalTickerFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
